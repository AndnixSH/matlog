<?xml version="1.0" encoding="utf-8"?>
<!--
    Shared attachments are staged in the app cache (see SaveLogHelper), so the
    FileProvider only needs to expose the cache and files directories. It used
    to expose the whole of external storage, which is both unnecessary and
    overly broad.
-->
<paths>
    <cache-path
        name="cache_files"
        path="." />
    <files-path
        name="internal_files"
        path="." />
</paths>
