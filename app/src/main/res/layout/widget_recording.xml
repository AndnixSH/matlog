<?xml version="1.0" encoding="utf-8"?>

<!--
    Everything here sizes itself from the widget's bounds rather than assuming
    a fixed 64dp. The widget declares a 40dp minimum, and with resizeMode="none"
    the launcher decides the actual cell - which can easily be smaller than the
    content used to be, clipping the icon.

    Only framework (android:) attributes belong in this file. A widget layout is
    inflated by the *launcher* using the platform inflater, so the AppCompat-only
    attributes are never read by the plain ImageViews the platform creates:
    app:tint did nothing (the icon rendered at full brightness instead of the
    dimmed #8f312f backdrop the white text needs) and app:srcCompat left the
    record badge with no drawable at all, so it could never appear while
    recording. Both are android:-namespace attributes below.

    The icon is adjustViewBounds rather than match_parent so that its *view*
    bounds are the square the artwork actually occupies, and the badge is
    aligned to that square's corner instead of the widget's. Measured on a
    Pixel 8 Pro: the widget came out 158x446 (one narrow column, three cells
    tall), so the icon sits in a 158x158 square adrift in the middle of it -
    a badge pinned to the widget's own corner floated ~130px below the disc.
    The adaptive icon draws its mask circle filling its bounds exactly, so
    aligning to the icon view puts the badge on the disc's edge at any size.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clickable_linear_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:adjustViewBounds="true"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@mipmap/ic_launcher"
        android:tint="#8f312f"
        android:tintMode="multiply"/>

    <ImageView
        android:id="@+id/record_badge_image_view"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_alignBottom="@id/widget_icon"
        android:layout_alignEnd="@id/widget_icon"
        android:contentDescription="@string/record_log"
        android:src="@drawable/ic_record_white_24dp"
        android:tint="#EF5350"
        android:visibility="invisible"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/widget_subtext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:ellipsize="end"
        android:fontFamily="sans-serif-condensed"
        android:gravity="center"
        android:maxLines="2"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="@string/widget_start_recording"
        android:textColor="@color/primary_text_default_material_dark"
        android:textSize="14sp" />

</RelativeLayout>
