<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Android 11 and later: on a rooted device MatLog switches this on for
        itself through su, and then saves logs to /sdcard/matlog, where it sees
        all of them, rather than Documents/matlog, where it sees only its own
        (see LogStorage). Nothing asks for it otherwise. It is declared for this
        build only: Google Play restricts the permission.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

</manifest>
